# ShiftsLabs — keep this file. Without it, `node_modules` and build output
# become committable and local secrets leak into git history.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (contains live credentials — never commit)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary files
.tmp/
_local/
.claude/
