# Required: an OpenAI-compatible teaching/chat API. DeepSeek example:
OPENAI_COMPATIBLE_API_KEY=your_deepseek_api_key
OPENAI_COMPATIBLE_API_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_MODELS=deepseek-chat

# Optional display name in the model selector:
# OPENAI_COMPATIBLE_PROVIDER_NAME=DeepSeek

# Optional Tutor upload and processing budgets, shared by Web and Worker.
# Defaults: 20 files/course, 20 MiB/file, 200 MiB/course; upload concurrency 3.
# TUTOR_MAX_FILES=20
# TUTOR_MAX_FILE_SIZE_MB=20
# TUTOR_MAX_COURSE_SIZE_MB=200
# TUTOR_UPLOAD_CONCURRENCY=3
# TUTOR_MAX_PDF_PAGES=500
# TUTOR_MAX_COURSE_PAGES=1000
# TUTOR_MAX_TEXT_CHARACTERS=2000000
# TUTOR_MAX_DOCUMENT_TOKENS=200000
# TUTOR_MAX_COURSE_TOKENS=500000
# TUTOR_MAX_DOCUMENT_CHUNKS=2000
# TUTOR_MAX_COURSE_CHUNKS=5000
# TUTOR_PARSE_TIMEOUT_MS=120000
# TUTOR_PARSE_MEMORY_MB=512
